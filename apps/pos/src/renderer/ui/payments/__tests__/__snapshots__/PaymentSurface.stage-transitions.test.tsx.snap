exports[`RT-1226 AC2 — PaymentSurface stage transitions (characterization) > hold (live tender): a refused settle reads a force-failed attempt with live tender > bridge calls 1`] = `
[
  "payments.start due=5000",
  "payments.read #1",
  "tender.apply cash amount=5000",
  "payments.read #2",
  "payments.confirm",
  "payments.read #3",
]
`;

