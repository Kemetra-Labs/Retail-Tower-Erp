exports[`RT-1226 AC2 — PaymentSurface stage transitions (characterization) > hold (unconfirmed): cancel answer and read-back lost → payment held, Cancel offered > bridge calls 1`] = `
[
  "payments.start due=10000",
  "payments.read #1",
  "payments.cancel",
  "payments.read #2",
  "payments.read #3",
  "payments.read #4",
]
`;

