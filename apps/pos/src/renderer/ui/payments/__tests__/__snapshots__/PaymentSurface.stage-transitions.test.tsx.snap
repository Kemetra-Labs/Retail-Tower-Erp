al-entry__actions"></div></section></div></div><section class="v5-ledger" aria-label="المبلغ المستحق"><div class="v5-ledger__due" data-fit="pinned"><span class="v5-ledger__due-label" data-testid="payment-surface-amount-label">المبلغ المستحق</span><span class="v5-ledger__due-value" data-testid="payment-surface-amount-due" dir="ltr">0.00 <span class="v5-ledger__due-currency">EGP</span></span></div><div class="v5-ledger__middle"><div class="v5-ledger-recorded" data-testid="payment-ledger" role="group" aria-labelledby="v5-ledger-recorded-label"><span class="v5-ledger-recorded__label" id="v5-ledger-recorded-label">المبالغ المسجَّلة</span><ul class="v5-ledger-recorded__lines"><li class="v5-ledger-row" data-testid="payment-ledger-line"><span>نقدي</span><span class="v5-ledger-row__amount" dir="ltr">30.00 EGP</span></li><li class="v5-ledger-row" data-testid="payment-ledger-line"><span>بطاقة</span><span class="v5-ledger-row__amount" dir="ltr">70.00 EGP</span></li></ul></div></div><div class="v5-ledger__actions" data-fit="pinned"><div class="v5-checkout-actions" data-testid="payment-surface-actions"><div class="v5-checkout-actions__row"><div class="v5-checkout-actions__slot v5-checkout-actions__slot--end" data-slot="end"><button type="button" class="v5-btn v5-btn--primary v5-btn--commit" data-testid="payment-surface-confirm">تأكيد الدفع</button></div><div class="v5-checkout-actions__slot v5-checkout-actions__slot--start" data-slot="start"><button type="button" class="v5-btn v5-btn--danger-quiet" data-testid="payment-surface-cancel">إلغاء</button></div></div></div></div></section></div></section></div><output class="v5-fit-guard__live" data-testid="fit-block-live"></output></div>",
  "focus": "payment-surface-confirm",
}
