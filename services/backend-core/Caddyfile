# Caddy — automatic HTTPS for the public edge template: one origin for the
# Backend-Core API and the Admin Console (RT-336, owner decision 2026-10-09).
#
#   /api, /api/*  -> api:3000 (Admin, POS and Connector API traffic, untouched)
#   everything else -> the current pinned Admin Console release (RT-337 artifact)
#
# The site address comes from CADDY_SITE_ADDRESS (default: the placeholder
# api.example.test). DNS for that hostname should point at <app-host>; Caddy
# auto-provisions and renews a TLS certificate where the hostname and CA support
# it, then reverse-proxies cleartext to the api container on the internal network.
#
# Real deployment hostnames belong in private ops config or the host environment,
# not public git.
# Requires: ports 80 + 443 open and DNS A/AAAA records pointing to <app-host>.

{$CADDY_SITE_ADDRESS:api.example.test} {
	encode gzip

	# RT-616: VN-S6 POS terminals probe liveness every 10 s (owner decision on
	# RT-600). A 2xx/3xx answer is proxied unchanged but writes no access-log
	# line; an upstream error, a timeout or a 4xx/5xx answer is still logged.
	@health_live path /api/v1/health/live
	handle @health_live {
		reverse_proxy api:3000 {
			@probe_ok status 2xx 3xx
			handle_response @probe_ok {
				log_skip
				copy_response
			}
		}
	}

	# Matched before the Console: an unknown /api path gets the API's own 404,
	# never the SPA's index.html. The API keeps its own (helmet) headers.
	@api path /api /api/*
	handle @api {
		reverse_proxy api:3000
	}

	# RT-1115 (RT-1082): the POS lab update feed at /pos-feed/lab/, only where the host sets
	# POS_FEED_DIR. Unset (this template's default) the matcher never matches and /pos-feed/*
	# stays the Console's. Plain static files from the read-only feed mount: HTTP Range for the
	# differential download and no SPA fallback, so a missing file is a 404, never index.html.
	@pos_feed {
		path /pos-feed/*
		expression `{env.POS_FEED_DIR} != ""`
	}
	handle @pos_feed {
		uri strip_prefix /pos-feed
		root * /srv/pos-feed
		header {
			Cache-Control "no-cache"
			X-Content-Type-Options "nosniff"
		}
		file_server
	}

	# Admin Console: /srv/console/current is a relative symlink to one unpacked,
	# checksum-verified release, so a release or rollback is a symlink swap with
	# no Caddy restart (deploy/README.md).
	handle {
		root * /srv/console/current

		# RT-1305: the Console's Download POS hands the presigned pilot installer URL to a hidden
		# iframe (RT-1304), so the URL never reaches the address bar. Only when the host sets a
		# valid pilot bucket and region (the values the api presigner signs for, RT-1297) does the
		# CSP gain one frame-src: that bucket's virtual-hosted S3 origin. Unset or malformed, the
		# CSP stays exactly the base policy. The two matchers are exclusive: one CSP per response.
		@pilot_frame expression `{env.POS_PILOT_RELEASE_BUCKET}.matches("^[a-z0-9][a-z0-9-]*[a-z0-9]$") && {env.POS_PILOT_RELEASE_S3_REGION}.matches("^[a-z][a-z](-[a-z]+)+-[0-9]+$")`
		@no_pilot_frame not expression `{env.POS_PILOT_RELEASE_BUCKET}.matches("^[a-z0-9][a-z0-9-]*[a-z0-9]$") && {env.POS_PILOT_RELEASE_S3_REGION}.matches("^[a-z][a-z](-[a-z]+)+-[0-9]+$")`
		header @pilot_frame Content-Security-Policy "default-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; frame-src https://{env.POS_PILOT_RELEASE_BUCKET}.s3.{env.POS_PILOT_RELEASE_S3_REGION}.amazonaws.com"
		header @no_pilot_frame Content-Security-Policy "default-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
		}

		# Content-hashed by Vite. A missing asset is a 404, not index.html.
		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# index.html, version.json and client-side routes (SPA fallback).
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}

	log {
		output stdout
		format console
	}
}
