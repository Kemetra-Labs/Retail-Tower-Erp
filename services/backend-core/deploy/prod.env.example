# Data-Pulse-2 deploy env template.
# Copy to deploy/prod.env on <app-host> and fill private references/values.
# Contains NO secret values — only secret-manager references + non-secret config.
# Resolved at runtime by:  op run --env-file=deploy/prod.env -- docker compose ...
#
# All four database URLs point at <managed-db> with SSL required, each with a
# DIFFERENT role (see docs/operations/database-roles.md; compose refuses to
# start without all four). Store the full URLs in private ops config or a
# secret manager, never public git.
#
#   MIGRATION_DATABASE_URL    migration owner (DDL); injected ONLY into `migrate`
#   DATABASE_URL              domain runtime role: non-superuser, NOBYPASSRLS
#   AUTH_LOOKUP_DATABASE_URL  pre-tenant lookup role: non-superuser, BYPASSRLS,
#                             only the table grants listed in database-roles.md
#                             (template: docs/operations/sql/auth-lookup-role.sql)
#   AUDIT_RETENTION_DATABASE_URL  audit retention role `audit_retention_worker`:
#                             LOGIN set by a superuser; only SELECT and
#                             UPDATE (retention_marked_at) on audit_events (RT-353)
#
# The API and worker refuse to boot in production when a role violates its
# posture (role attributes, the lookup role's table grants, and the audit
# retention role's grants).

MIGRATION_DATABASE_URL="<secret-manager-ref>"
DATABASE_URL="<secret-manager-ref>"
AUTH_LOOKUP_DATABASE_URL="<secret-manager-ref>"
AUDIT_RETENTION_DATABASE_URL="<secret-manager-ref>"
REDIS_URL="redis://:${REDIS_PASSWORD}@redis:6379"
REDIS_PASSWORD="<secret-manager-ref>"
LOG_LEVEL="info"
# RT-152: dev | staging | pilot | prod. Connector feed refuses other environments.
DEPLOYMENT_ENVIRONMENT="<dev|staging|pilot|prod>"

# Reverse-proxy hop count for Express trust proxy (default: 1 for single Caddy).
TRUST_PROXY="1"
# RT-624: optional, off by default. Set to "true" to refuse boot in a deployed environment
# when TRUST_PROXY is unset (otherwise only a warning is logged).
# TRUST_PROXY_REQUIRED="true"
# CORS allowed origins (comma-separated). Leave empty to disable cross-origin requests.
# The Admin Console is served on the same origin (RT-336), so this stays empty.
# docker-compose.prod.yml deliberately does not pass it to the api (RT-336/RT-984):
# CORS and the extra origins the cookie-session check trusts stay off.
ALLOWED_ORIGINS=""

# RT-984: the remaining API deployment gates. All off by default and read per
# request; each accepts "1", "true" or "yes".
# RT-73: recordReturn (404 while off). Only after the Connector supports
# `return` (RT-16) and settlement (RT-78).
POS_RETURNS_ENABLED="false"
# RT-787: settle-before-post refunds. Only once every till sends allocationRef
# and reports its refund executions.
POS_REFUND_SETTLE_BEFORE_POST_ENABLED="false"
# RT-787: the deprecated amount-only recordRefund (404 while off). No POS calls it.
POS_LEGACY_REFUND_ENABLED="false"
# RT-370: refuse expired device tokens on every device route. Owner decision,
# only after the POS rotation client (RT-373) is on every till and the expiry
# cluster is re-baselined (docs/operations/sql/device-expiry-rebaseline.sql).
DEVICE_TOKEN_EXPIRY_ENFORCED="false"
# RT-655: AI generation kill switch (AD-AI-PROV-001).
AI_GATEWAY_ENABLED="false"
# RT-124: durable outbox audit path. Leave EMPTY: unset means ON in production.
# Set "0" only to opt out on purpose.
OUTBOX_AUDIT_ENABLED=""

# RT-984 tuning settings. Leave empty for the code default; an invalid value
# falls back to the default (AI_RESERVATION_TTL_SECONDS refuses boot instead).
# AI_RESERVATION_TTL_SECONDS=""            # default 900, minimum 60
# PUBLIC_AUTH_LIMITER_TIMEOUT_MS=""        # default 1000, 1..10000
# CONSOLE_RATE_LIMIT_MODE=""               # off (default) | report | enforce
# CONSOLE_RATE_LIMIT_TIMEOUT_MS=""         # default 250, 1..10000
# PREAUTH_RATE_LIMIT_MODE=""               # off (default) | report
# PREAUTH_RATE_LIMIT_LIMIT=""              # default 300, 1..1000000
# PREAUTH_RATE_LIMIT_WINDOW_MS=""          # default 300000, 1000..3600000
# PREAUTH_RATE_LIMIT_TIMEOUT_MS=""         # default 250, 1..10000
# CASHIER_ADMISSION_TTL_SECONDS=""         # default 43200, 1..604800
# CASHIER_OFFLINE_GRACE_SECONDS=""         # default 86400
# CASHIER_TAKEOVER_RATE_LIMIT=""           # default 10
# CASHIER_TAKEOVER_RATE_WINDOW_SECONDS=""  # default 3600
# CASHIER_TAKEOVER_LIMITER_TIMEOUT_MS=""   # default 250, 1..10000

# RT-336 same-origin edge. Public hostname Caddy serves (real value: private ops config).
CADDY_SITE_ADDRESS="api.example.test"
# Host directory with pinned Admin Console releases + the `current` symlink
# (deploy/README.md "Admin Console release"). Compose refuses to start without it.
CONSOLE_RELEASES_DIR="/opt/dp2-console"

# POS-operator identity (RT-800/RT-941): Descope is the only provider.
# DESCOPE_PROJECT_ID is REQUIRED (compose declares ${DESCOPE_PROJECT_ID:?...}); it is
# a public project identifier, not a secret. Any IDENTITY_PROVIDER other than
# "descope" fails the API at boot.
IDENTITY_PROVIDER="descope"
DESCOPE_PROJECT_ID="<descope-project-id>"
# Optional overrides (leave blank to derive both from the project id):
DESCOPE_JWT_ISSUER=""
DESCOPE_JWT_AUDIENCE=""
# RT-1122: the oldest session token (seconds since its iat) the API accepts.
# Blank = 30600 (the 8 h session TTL plus 30 min). Allowed 60-86400; any other
# value fails the API at boot. Raise it with the Descope session TTL, never past it by much.
DESCOPE_JWT_MAX_TOKEN_AGE_SECONDS=""
# RT-937 invite accept only (RT-1123). SECRET: keep the value in the secret manager or the
# host env file, never in git. Unset or empty fails invite accept closed (503); sign-in is
# unaffected. Rotation: docs/operations/descope-management-key-rotation.md.
DESCOPE_MANAGEMENT_KEY=
# RT-1043 REQUIRED, SECRET: the HMAC key behind the public-auth rate-limit keys (sign-in,
# password reset, email verify, invite accept), so Redis holds no raw email or client IP.
# At least 32 characters: generate with `openssl rand -hex 32`, keep the value in the secret
# manager or the host env file, never in git or logs. Compose refuses to start without it
# and the api refuses to boot on an unset or short value. First deploy, and every rotation,
# resets all public-auth counters once (deploy/README.md).
PUBLIC_AUTH_RATE_LIMIT_KEY_SECRET="<secret-manager-ref>"

# RT-1280 REQUIRED for the worker: invitation email through Amazon SES. In production the
# worker refuses to boot unless EMAIL_TRANSPORT=ses and the three settings below are valid
# (the api is unaffected). Set them BEFORE the first deploy that includes RT-1280.
EMAIL_TRANSPORT="ses"
# The sender the IAM sending identity is pinned to (ses:FromAddress), on a verified SES domain.
EMAIL_FROM="no-reply@<verified-domain>"
SES_REGION="us-east-1"
# Admin Console origin for invitation accept links: https, no path, query or credentials.
CONSOLE_BASE_URL="https://<console-host>"
# SECRET: the access key of the SES-send-only IAM user. Passed to the worker container only
# (as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY). Keep it in the root-only host env file or
# the secret manager, never in git, logs, Jira or PRs.
EMAIL_SES_ACCESS_KEY_ID="<secret-manager-ref>"
EMAIL_SES_SECRET_ACCESS_KEY="<secret-manager-ref>"

# RT-1292 / RT-1297 OPTIONAL: the POS pilot release lane (Console "Download POS" for allowlisted
# pilot tenants). Leave all of them blank and the lane stays off (the Console gets
# { available: false }); the api is unaffected. It turns on only when the pin, the bucket AND
# the three S3 values are all valid. Setup: docs/operations/pos-pilot-release-bucket.md.
# The pilot installer's Authenticode subject, exactly as the signing certificate carries it.
POS_PILOT_RELEASE_PUBLISHER=""
# The private pilot bucket (all four Block Public Access settings on). No dots in the name.
# RT-1305: Caddy also reads this and the region below. When both are valid, the Console CSP
# allows https://<bucket>.s3.<region>.amazonaws.com as its only frame-src; otherwise none.
POS_PILOT_RELEASE_BUCKET=""
# Presigned URL lifetime in seconds, integer 1-900. Blank = 300. Any other value turns the lane off.
POS_PILOT_RELEASE_URL_TTL_SECONDS=""
# The bucket's region, for example us-east-1 for the lab.
POS_PILOT_RELEASE_S3_REGION=""
# SECRET: the access key of the read-only pilot-bucket IAM user (s3:GetObject and
# s3:GetObjectVersion on pos/pilot/* only). Passed to the api container only, under these names;
# the api uses no ambient AWS credential (AWS_ACCESS_KEY_ID, a profile, an instance role). Keep it
# in the root-only host env file or the secret manager, never in git, logs, Jira or PRs. Left blank
# here on purpose: a junk value would bind a presigner that signs with a key S3 refuses.
POS_PILOT_RELEASE_S3_ACCESS_KEY_ID=""
POS_PILOT_RELEASE_S3_SECRET_ACCESS_KEY=""

# RT-1298 OPTIONAL: the pins of the promotion workflow's GitHub OIDC token, which registers and
# withdraws a pilot release (no stored secret). Blank = every workflow write is 401 and the api is
# unaffected. All five must be set, and match the token GitHub issues for the promotion job:
# the audience the workflow requests, the repository (owner/name), the protected approval
# environment of the job, the ref, and the job_workflow_ref
# (owner/name/.github/workflows/<file>@<ref>). Not secrets. Setup:
# docs/operations/pos-pilot-release-bucket.md section 7.
POS_PILOT_PROMOTION_OIDC_AUDIENCE=""
POS_PILOT_PROMOTION_OIDC_REPOSITORY=""
POS_PILOT_PROMOTION_OIDC_ENVIRONMENT=""
POS_PILOT_PROMOTION_OIDC_REF=""
POS_PILOT_PROMOTION_OIDC_WORKFLOW_REF=""

# RT-77 / RT-360 sale-tender capture gates (RT-983); both default off.
# POS_SALE_TENDERS_ENABLED: set "true" only after the ERPNext Connector with
# RT-78 is deployed and its tender map has a row for every method the POS sends
# (a pre-RT-78 Connector posts a tendered sale unpaid). Turn it on before any
# terminal sets POS_PULSE_FEATURE_SALE_TENDERS_SINCE: until then the API refuses
# a sale with tenders (400) and the POS dead-letters it.
POS_SALE_TENDERS_ENABLED="false"
# Same-method split tenders: only after RT-361, and only with the gate above on.
POS_SALE_TENDERS_SAME_METHOD_ENABLED="false"

# Spec 037 observability — every value below is optional and default-inert.
# Sentry (errors only): leave SENTRY_DSN empty to send nothing. The DSN is a
# project ingest key, kept in the secret manager, never in public git.
SENTRY_DSN=""
# Release SHA12 of the deployed commit: Sentry `release` + span `service.version`.
SENTRY_RELEASE=""
# Console Sentry project (RT-632): the api forwards the Admin-Console's scrubbed
# error events to this DSN through its same-origin tunnel. Empty = tunnel inert.
CONSOLE_SENTRY_DSN=""
# POS Sentry project (RT-1252): the api forwards paired terminals' scrubbed error
# events to this DSN through its device-authenticated tunnel. Terminals never hold
# a DSN. POS_TELEMETRY_REF_KEY (secret, at least 32 characters) keys the
# tenant/store/terminal refs; rotate it only on compromise. Either empty = inert.
POS_SENTRY_DSN=""
POS_TELEMETRY_REF_KEY=""
# Datadog Agent (opt-in: `docker compose --profile datadog up -d`). DD_API_KEY is
# a secret-manager reference. When enabling, also set
# OTEL_EXPORTER_OTLP_ENDPOINT="http://datadog-agent:4318" so api + worker send traces to it.
DD_API_KEY=""
DD_SITE="datadoghq.eu"
# Required for the agent without the Docker socket; real value in private ops config.
DD_HOSTNAME=""
# OTEL_EXPORTER_OTLP_ENDPOINT=""
# Trace sampling (parent-based ratio). Default 10%; raise only with a budget decision.
# OTEL_TRACES_SAMPLER_ARG="0.1"

# RT-418: keep EMPTY until the RT-419 Connector is deployed (credit sales stay held
# off the posting feed). Not yet mapped into the api container by
# docker-compose.prod.yml (unmapped = held); the RT-419 hold lift adds the mapping.
# To enable, follow deploy/README.md "Enabling credit posting".
ERPNEXT_FEED_RESPONSIBILITIES_ENABLED=""
